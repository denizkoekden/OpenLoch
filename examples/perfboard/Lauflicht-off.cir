op
wrdata Lauflicht-off.dat v(LED0_A) v(BASE0) v(COL0) v(LED1_A) v(BASE1) v(COL1) v(LED2_A) v(BASE2) v(COL2) v(LED3_A) v(BASE3) v(COL3) v(LED4_A) v(BASE4) v(COL4) v(LED5_A) v(BASE5) v(COL5) v(LED6_A) v(BASE6) v(COL6) v(LED7_A) v(BASE7) v(COL7) v(LED8_A) v(BASE8) v(COL8) v(LED9_A) v(BASE9) v(COL9)
